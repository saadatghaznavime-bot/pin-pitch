# Required for local API authentication. Replace with a long random secret.
JWT_SECRET=replace-with-a-unique-long-random-secret
JWT_EXPIRE_MINUTES=60

# Optional local AI gateway settings (Windows PC only).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_MODEL=
LOCAL_AI_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# No paid external provider credentials are required or used by the demo.
